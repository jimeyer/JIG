{
  "name": "Python Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "dev",
  "postCreateCommand": "pip install --user -e '.[dev]' 2>/dev/null || pip install --user -e . 2>/dev/null || true",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [],
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,readonly"
  ]
}
