{
  "name": "Python Dev Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USER_UID": "${localEnv:DEVCONTAINER_UID}",
      "USER_GID": "${localEnv:DEVCONTAINER_GID}"
    }
  },
  "remoteUser": "dev",
  "postCreateCommand": "(pip install --user -e '.[dev]' 2>/dev/null || pip install --user -e . 2>/dev/null || true) && pip install --user -e /tools/jig -e /tools/dig",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "IN_DEVCONTAINER": "1"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [],
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind",
    "source=${localEnv:HOME}/Code/jig,target=/tools/jig,type=bind",
    "source=${localEnv:HOME}/Code/jig-dev,target=/tools/jig-dev,type=bind",
    "source=${localEnv:HOME}/Code/dig,target=/tools/dig,type=bind",
    "source=${localEnv:HOME}/Code/dig-dev,target=/tools/dig-dev,type=bind",
    "source=${localEnv:HOME}/Code/dotfiles/bin,target=/tools/bin,type=bind,readonly"
  ]
}
